{
  "info": {
    "name": "LankaLibrary Pro API",
    "description": "Complete API collection for LankaLibrary Pro — Library Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@123\",\n  \"phone\": \"+94771234567\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "  pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lankalibrary.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login (Staff)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "  pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kamal@lankalibrary.com\",\n  \"password\": \"Staff@123\"\n}"
            }
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "  pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"saman@gmail.com\",\n  \"password\": \"User@123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List Books (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "category", "value": "Fiction", "disabled": true },
                { "key": "available", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/books",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Book\",\n  \"author\": \"Author Name\",\n  \"isbn\": \"978-9999999999\",\n  \"category\": \"Technology\",\n  \"publisher\": \"Publisher\",\n  \"quantity\": 5\n}"
            }
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/books/BOOK_ID_HERE"
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/books/BOOK_ID_HERE",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"quantity\": 10\n}"
            }
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/books/BOOK_ID_HERE"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "role", "value": "USER", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Secure@123\",\n  \"role\": \"USER\",\n  \"phone\": \"+94771234567\"\n}"
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/USER_ID_HERE"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/USER_ID_HERE",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\"\n}"
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/USER_ID_HERE"
          }
        }
      ]
    },
    {
      "name": "Staff",
      "item": [
        {
          "name": "List Staff",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/staff?page=1&limit=10"
          }
        },
        {
          "name": "Create Staff",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/staff",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Staff\",\n  \"email\": \"staff@lankalibrary.com\",\n  \"password\": \"Staff@123\",\n  \"phone\": \"+94771234567\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "Issue a Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/issues/issue",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_ID_HERE\",\n  \"bookId\": \"BOOK_ID_HERE\"\n}"
            }
          }
        },
        {
          "name": "Return a Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/issues/return",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"issueId\": \"ISSUE_ID_HERE\"\n}"
            }
          }
        },
        {
          "name": "List Issues",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/issues?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["issues"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "ISSUED", "disabled": true }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Fines",
      "item": [
        {
          "name": "List Fines",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/fines?page=1&limit=10"
          }
        },
        {
          "name": "Pay Fine",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/fines/FINE_ID_HERE",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAID\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications?page=1&limit=10"
          }
        },
        {
          "name": "Send Notification",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notifications",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_ID_HERE\",\n  \"title\": \"Test Notification\",\n  \"message\": \"This is a test notification.\",\n  \"type\": \"SYSTEM\"\n}"
            }
          }
        },
        {
          "name": "Broadcast Notification",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notifications",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"broadcast\": true,\n  \"title\": \"Library Announcement\",\n  \"message\": \"Library will be closed next Monday.\"\n}"
            }
          }
        },
        {
          "name": "Mark as Read",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/notifications/NOTIFICATION_ID_HERE"
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Daily Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/daily?date=2024-01-01"
          }
        },
        {
          "name": "Monthly Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/monthly?year=2024&month=1"
          }
        },
        {
          "name": "Overdue Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/overdue"
          }
        },
        {
          "name": "Fine Collections Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/fines"
          }
        },
        {
          "name": "Active Users Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/active-users?limit=20"
          }
        },
        {
          "name": "Most Borrowed Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/reports/most-borrowed?limit=20"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/dashboard"
          }
        }
      ]
    },
    {
      "name": "Activity Logs",
      "item": [
        {
          "name": "Get Activity Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/activity-logs?page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get All Settings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/settings"
          }
        },
        {
          "name": "Update Setting",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/settings",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"fine_per_day\",\n  \"value\": \"10\",\n  \"description\": \"Fine per overdue day\"\n}"
            }
          }
        },
        {
          "name": "Bulk Update Settings",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/settings",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"settings\": [\n    { \"key\": \"fine_per_day\", \"value\": \"10\" },\n    { \"key\": \"loan_days\", \"value\": \"21\" }\n  ]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Backup",
      "item": [
        {
          "name": "Generate Database Backup",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/backup"
          }
        }
      ]
    }
  ]
}
